# Atomic Development Configuration
# This file is gitignored and local to your machine

# Frontend server configuration
VITE_ATOMIC_SERVER_URL=http://localhost:44380
VITE_BUILD_TARGET=desktop

# Optional: uncomment to debug server communication
# VITE_ATOMIC_SERVER_URL=http://localhost:8080

# Optional: Rust logging (debug, info, warn, error)
# RUST_LOG=debug

# Optional: Enable Rust backtraces for better error information
# RUST_BACKTRACE=1
